{
  // trustsight-feed: a Worker that polls an ntfy topic on a cron, stores every
  // notification in D1, and serves the feed API plus the static Preact app.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trustsight-feed",
  "main": "worker/index.js",
  "compatibility_date": "2025-08-01",
  "observability": { "enabled": true },
  // Static frontend. `not_found_handling` gives the detail routes
  // (/<date>/<time>/) back the SPA shell; API paths never match an asset so
  // they reach the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this, the SPA fallback answers a browser navigation to
    // /api/feed with index.html before the Worker runs, so the API is only
    // reachable by non-navigation clients. Run the Worker first for all
    // requests; it forwards non-API paths back to the assets binding.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trustsight-feed",
      "database_id": "541b4a69-29ae-422a-ad38-6076c5ae0b54",
      "migrations_dir": "migrations"
    }
  ],
  // Per client the public API is capped at 120 requests a minute. The free
  // Workers rate limiting binding; no request reaches D1 past the cap.
  // (Windows are 10s or 60s only, so this is 120 per 60s, not per second.)
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    // Search routes can fall back to a fuzzy window; cap them separately so a
    // single client cannot turn misses into a large D1 read budget.
    {
      "name": "SEARCH_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "routes": [
    { "pattern": "watcher.trustsight.org", "custom_domain": true }
  ],
  "vars": {
    "NTFY_SERVER": "https://ntfy.sh",
    "NTFY_TOPIC": "trustsight-aur-1d8a3fd2"
  }
}
