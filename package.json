{
  "name": "trustsight-feed",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Searchable feed of TrustSight ntfy notifications, hosted at watcher.trustsight.org.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/optimize.mjs",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "test": "vitest run",
    "generate:rules": "python scripts/build_rule_catalog.py",
    "verify:rules": "python scripts/build_rule_catalog.py --check",
    "verify:csp": "node scripts/verify-csp.mjs",
    "deploy": "npm run build && wrangler deploy",
    "db:apply": "wrangler d1 migrations apply trustsight-feed"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@preact/preset-vite": "2.10.6",
    "lightningcss": "1.33.0",
    "preact": "10.29.8",
    "terser": "5.50.0",
    "vite": "8.2.1",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
